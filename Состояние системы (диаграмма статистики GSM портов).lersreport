  &lt;CalculatedFields&gt;
    &lt;Item1 Ref="13" Name="measurePoints" FieldType="String" Expression="'на автоопросе - ' + [AutoPollTotal] + ', неопрошено - ' + [AutoPollNotPolled] + '  ( ' + Round([AutoPollNotPolledPercent], 1) + ' % )'" DataMember="SystemStateParametersCollection" /&gt;
    &lt;Item2 Ref="14" Name="pollPorts" FieldType="String" Expression="'всего - ' + [PollPortTotal] + ' (работающих - ' + [PollPortActive] + ')'" DataMember="SystemStateParametersCollection" /&gt;
