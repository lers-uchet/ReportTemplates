    &lt;Item4 Ref="16" Name="licenseNode" FieldType="String" DisplayName="licenseNode" Expression="'всего - ' + [NodeLicenseCount] + ', используется - ' + [NodeLicenseUsed]" DataMember="SystemStateParametersCollection" /&gt;
    &lt;Item5 Ref="17" Name="licenseRoom" FieldType="String" Expression="'всего - ' + [CommunalPollLicenseCount]+ ', используется - ' + [CommunalPollLicenseUsed]" DataMember="SystemStateParametersCollection" /&gt;
    &lt;Item6 Ref="18" Name="serverWorkTime" FieldType="String" Expression="Substring(ToStr(LocalDateTimeNow() - [ServerStartDateTime]), 0, 11)" DataMember="SystemStateParametersCollection" /&gt;
    &lt;Item7 Ref="19" Name="currentDateTime" FieldType="DateTime" Expression="LocalDateTimeNow()" /&gt;
