    &lt;Item13 Ref="25" Name="dataExist" FieldType="Boolean" Expression="[][[^.Territory] == [Territory]].Sum(Iif(IsNull([Temperature]), 0, 1)) &amp;gt; 0" DataMember="OutdoorTempInfo" /&gt;
